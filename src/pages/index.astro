---
import TranslateBox from '../components/TranslateBox.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phrase Paraphraser — ID → NL → EN → ID</title>
    <meta name="description" content="Parafrase teks Indonesia melalui jalur bahasa Belanda dan Inggris." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='80' font-size='80'>✦</text></svg>"
    />

    <!-- Fonts: preconnect early so the browser preload scanner discovers them immediately -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Open Graph -->
    <meta property="og:title" content="Phrase Paraphraser — Multi-Language Recursive Paraphrase Engine" />
    <meta property="og:description" content="Parafrase teks Indonesia via pipeline 3-hop: ID → NL → EN → ID. Ubah struktur kalimat drastis tanpa ngubah makna." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://phrase-paraphraser.vercel.app" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Phrase Paraphraser — ID → NL → EN → ID" />
    <meta name="twitter:description" content="Parafrase teks Indonesia melalui jalur bahasa Belanda dan Inggris." />
  </head>
  <body class="bg-terminal-deep min-h-screen relative overflow-x-hidden">
    <div class="fixed inset-0 pointer-events-none z-0" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>

    <main class="relative z-[1]">
      <TranslateBox />
    </main>
  </body>
</html>

<style>
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
  }

  .orb-1 {
    width: 500px;
    height: 500px;
    top: -150px;
    left: -100px;
    background: radial-gradient(circle, theme('colors.accent.DEFAULT'), transparent 70%);
    animation: drift 12s ease-in-out infinite alternate;
  }

  .orb-2 {
    width: 400px;
    height: 400px;
    bottom: -100px;
    right: -80px;
    background: radial-gradient(circle, theme('colors.accent.blue'), transparent 70%);
    animation: drift 15s ease-in-out infinite alternate-reverse;
  }

  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(30px, 20px) scale(1.1); }
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(248 250 252 / 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
  }
</style>
