---
// src/components/FlowVisual.astro
---
<aside class="w-full max-w-[720px] mx-auto mb-6 box-border p-0" aria-hidden="true">
  <div class="flow-card-inner bg-terminal-surface border border-terminal-border py-2.5 px-4 rounded-md flex items-center justify-between">
    <div class="font-mono text-[0.72rem] text-terminal-dim tracking-[0.05em]">> ENGINE_PIPELINE</div>
    <div class="flow-visual flex items-center gap-1.5 font-mono">
      <span class="flow-node node-id bg-terminal-bg border border-terminal-border rounded text-terminal-body font-normal text-[0.75rem] py-0.5 px-1.5">id</span>
      <span class="flow-connector text-terminal-border-hover text-[0.8rem]">-></span>
      <span class="flow-node node-nl bg-terminal-bg border border-terminal-border rounded text-terminal-body font-normal text-[0.75rem] py-0.5 px-1.5">nl</span>
      <span class="flow-connector text-terminal-border-hover text-[0.8rem]">-></span>
      <span class="flow-node node-en bg-terminal-bg border border-terminal-border rounded text-terminal-body font-normal text-[0.75rem] py-0.5 px-1.5">en</span>
      <span class="flow-connector muted text-accent-dark text-[0.8rem]"><=</span>
      <span class="flow-node node-final final border-success/30 text-success bg-success/5 rounded font-normal text-[0.75rem] py-0.5 px-1.5">id_final</span>
    </div>
  </div>
</aside>

<style>
  @keyframes fv-blink {
    0%, 100% { opacity: 0.4; border-color: theme('colors.terminal.border'); color: theme('colors.terminal.body'); }
    50%      { opacity: 1;   border-color: theme('colors.accent.dark');     color: theme('colors.accent.DEFAULT'); }
  }

  .flow-node.processing { animation: fv-blink 1s steps(1) infinite; }

  @media (max-width: 640px) {
    .flow-card-inner { flex-direction: column; gap: 0.5rem; align-items: flex-start; padding: 0.6rem 0.8rem; }
    .flow-visual { gap: 0.25rem; flex-wrap: wrap; }
    .flow-visual .flow-node { font-size: 0.7rem; padding: 0.1rem 0.3rem; }
    .flow-connector { font-size: 0.75rem; }
  }
</style>