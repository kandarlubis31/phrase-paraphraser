---
// src/components/TranslateBox.astro
import AppHeader from "./AppHeader.astro";
import EditorialFeatures from "./EditorialFeatures.astro";
import FlowVisual from "./FlowVisual.astro";
import ResultProgress from "./ResultProgress.astro";
---

<div class="app-wrapper flex flex-col items-center py-12 px-6 gap-5 font-sans text-terminal-body bg-terminal-bg min-h-screen">
  <AppHeader />

  <EditorialFeatures />

  <FlowVisual />

  <div class="card-main w-full max-w-[720px] bg-terminal-surface border border-terminal-border rounded-md p-6 flex flex-col gap-5 relative shadow-none">
    <div id="linearProgress" class="linear-progress hidden rounded-t-md">
      <div class="linear-bar"></div>
    </div>

    <div class="input-section flex flex-col gap-2">
      <div class="section-label flex items-center justify-between font-mono text-xs text-terminal-dim uppercase">
        <div class="flex items-center gap-1.5">
          <span class="flag-mono text-terminal-bright bg-terminal-border py-px px-1 rounded-[3px]">[id_ID]</span>
          <span>Input Sumber</span>
        </div>
        <div class="flex gap-1.5 items-center">
          <button id="pasteBtn" class="action-btn bg-terminal-border border border-terminal-border-hover text-terminal-light py-0.5 px-2 rounded font-mono text-[0.7rem] cursor-pointer hover:border-terminal-dim focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Paste</button>
          <button id="clearBtn" class="action-btn ghost bg-transparent border-transparent text-terminal-dim hover:text-error focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Clear</button>
        </div>
      </div>
      <label for="inputText" class="sr-only">Teks yang akan diparafrase</label>
      <textarea
        id="inputText"
        aria-describedby="charCount"
        placeholder="Masukkan teks komparasi di sini..."
        maxlength="3000"
        class="w-full min-h-[130px] py-3 px-3.5 bg-terminal-bg border border-terminal-border rounded text-terminal-bright font-sans text-[0.9rem] font-normal leading-relaxed resize-y box-border caret-accent transition-colors focus:outline-none focus:border-terminal-border-hover"></textarea>
      <div class="char-row flex justify-end">
        <span id="charCount" class="char-count font-mono text-[0.7rem] text-terminal-muted">0 / 3000 EOF</span>
      </div>
    </div>

    <button id="paraphraseBtn" class="btn-paraphrase w-full py-3 px-4 bg-terminal-bright border border-terminal-bright text-terminal-bg font-mono text-[0.8rem] font-medium tracking-[0.05em] cursor-pointer rounded flex items-center justify-center transition-colors hover:opacity-85 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-terminal-surface">
      <span id="btnLabel">EXECUTE PARAPHRASE</span>
      <span id="btnSpinner" class="spinner-txt hidden">EXEC_</span>
    </button>

    <div id="errorBox" class="error-box hidden rounded font-mono text-xs" role="alert"></div>

    <ResultProgress />
  </div>

  <button id="goUpBtn" class="btn-go-up hidden flex items-center justify-center cursor-pointer rounded font-mono text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" aria-label="Kembali ke atas"
    >↑</button
  >

  <footer class="app-footer font-mono text-[0.7rem] text-terminal-muted w-full max-w-[720px] text-left mt-4">
    root@phrase-paraphraser:~#
    <a
      href="https://www.instagram.com/kandar.lubis31"
      target="_blank"
      rel="noopener"
      class="text-terminal-dim no-underline hover:text-accent"
      >@kandar.lubis31</a
    > ·
    <a href="https://github.com/kandarlubis31" target="_blank" rel="noopener"
      class="text-terminal-dim no-underline hover:text-accent"
      >GitHub</a
    > ·
    <a href="https://www.paklubis.my.id" target="_blank" rel="noopener"
      class="text-terminal-dim no-underline hover:text-accent"
      >paklubis.my.id</a
    >
  </footer>
</div>

<script>
  // Dynamic import: code-splits the entire client bundle (~14 KB)
  // so it's only loaded when the page is interactive, not at initial parse.
  document.addEventListener('DOMContentLoaded', () => {
    import('../client/paraphraseController').then(m => m.initParaphraser()).catch(console.error);
  });
  document.addEventListener('astro:page-load', () => {
    import('../client/paraphraseController').then(m => m.initParaphraser()).catch(console.error);
  });
</script>

<style>
  .linear-progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: theme('colors.terminal.border');
    overflow: hidden;
  }
  .linear-bar {
    width: 40%;
    height: 100%;
    background: theme('colors.accent.DEFAULT');
    animation: linearMove 1s linear infinite;
  }
  @keyframes linearMove {
    from { transform: translateX(-100%); }
    to   { transform: translateX(250%); }
  }

  .spinner-txt {
    color: theme('colors.terminal.dim');
    margin-left: 0.5rem;
    animation: blinkText 0.8s steps(1) infinite;
  }
  @keyframes blinkText { 50% { opacity: 0; } }

  .btn-go-up {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 99;
    background: theme('colors.terminal.surface');
    border: 1px solid theme('colors.terminal.border');
    color: theme('colors.terminal.body');
    width: 36px;
    height: 36px;
  }
  .btn-go-up:hover {
    border-color: theme('colors.terminal.border-hover');
    color: theme('colors.terminal.bright');
  }

  .error-box {
    padding: 0.6rem 0.8rem;
    background: rgb(239 68 68 / 0.05);
    border: 1px solid rgb(239 68 68 / 0.2);
    color: theme('colors.error-light');
    animation: errorEnter 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes errorEnter {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .btn-paraphrase {
    transition: background 0.15s ease-out, border-color 0.15s ease-out, color 0.15s ease-out;
  }

  .btn-paraphrase.cancelling {
    background: rgb(239 68 68 / 0.08);
    border-color: rgb(239 68 68 / 0.3);
    color: theme('colors.error-light');
  }
  .btn-paraphrase.cancelling:hover {
    background: rgb(239 68 68 / 0.15);
    border-color: theme('colors.error');
    color: #fecaca;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .app-wrapper { padding: 1.5rem 0.75rem; gap: 1rem; }
    .card-main { padding: 1rem; }
    .btn-go-up { bottom: 1.5rem; right: 1.5rem; }
  }
</style>
