# Phrase Paraphraser — Environment Variables
# Copy this file to .env and adjust values as needed
# cp .env.example .env

# ── API MODE ──────────────────────────────────────────────
# "on"  → Gunakan Cloudflare Worker proxy (default, butuh internet)
# "off" → Gunakan LibreTranslate self-hosted (unlimited, lokal)
PUBLIC_API_MODE=on

# ── CLOUDFLARE WORKER (API_MODE=on) ───────────────────────
# Cloudflare Worker proxy URL for the translation pipeline
# This worker handles the ID → NL → EN → ID translation chain
# Replace with your own worker URL if self-hosting
PUBLIC_WORKER_URL=https://phrase-proxy.kandarlubis31.workers.dev

# ── LIBRETRANSLATE (API_MODE=off) ─────────────────────────
# URL to your self-hosted LibreTranslate instance
# Default: local Docker instance
# Docker run: docker run -d -p 5000:5000 --name libretranslate libretranslate/libretranslate
#
# ⚠️  SECURITY NOTE: This URL will be bundled into client-side JavaScript.
#     Anyone viewing your site can see this URL in the browser's dev tools.
#     DO NOT use a URL that exposes your internal network publicly.
#     For production with API_MODE=off, use a reverse proxy or tunnel.
PUBLIC_LIBRETRANSLATE_URL=http://localhost:5000
